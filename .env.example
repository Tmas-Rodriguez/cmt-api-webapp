# Usuarios de la webapp = admins activos del data entry (app.users en Postgres).
# Copiar como .env (no se versiona) y completar con un rol de SOLO LECTURA sobre app.users:
#
#   CREATE ROLE cmt_webapp_auth LOGIN PASSWORD '<clave>';
#   GRANT CONNECT ON DATABASE manual_data_entry TO cmt_webapp_auth;
#   GRANT USAGE ON SCHEMA app TO cmt_webapp_auth;
#   GRANT SELECT (username, password_hash, role, active) ON app.users TO cmt_webapp_auth;
DATA_ENTRY_DB_URL=postgresql://cmt_webapp_auth:<clave>@localhost:5432/manual_data_entry
